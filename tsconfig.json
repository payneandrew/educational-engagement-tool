{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": true
  },
  "include": ["e2e", "playwright.config.ts", "server/src", "shared", "web/src", "scripts", "vite.config.ts"]
}
